#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: swarmarchy-iso-upload [release/swarmarchy.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: swarmarchy-iso-rclone-config"
  exit 1
fi

rclone copy $1 Swarmarchy:swarmarchy/ -P

if [[ -f $1.sig ]]; then
  rclone copy $1.sig Swarmarchy:swarmarchy/ -P
fi
