# Packages for the ISO's live environment + the base target install.
# (build-iso.sh parses only the first token, so inline '# notes' are fine.)

base               # core Arch base meta-package
base-devel         # compilers/make — needed to build AUR packages on first boot
linux-aarch64      # the live + install kernel (generic ARM; swap for a Snapdragon-X kernel)
linux-firmware     # device firmware blobs (Wi-Fi/GPU/etc.)
alsa-firmware      # extra sound-card firmware
limine             # the bootloader (installed to the target disk)
efibootmgr         # create/edit UEFI boot entries during install
openssh            # SSH server/client (remote install or post-install access)
pipewire           # audio in the live environment
snapper            # set up Btrfs snapshots at install time
btrfs-progs        # mkfs.btrfs in the live ISO + btrfs tooling on the target

# Removed for aarch64:
#   amd-ucode, intel-ucode  -> x86 CPU microcode (n/a on ARM)
#   sof-firmware            -> Intel audio DSP firmware (n/a)
# Generic ALARM build — package verification uses archlinuxarm-keyring; no omarchy repo.
